{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pqhcijtvnfxrcrxolwph.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "project-finish-line",
      "version": "0.1.0",
      "title": "Project Finish Line"
    },
    "tools": [
      {
        "name": "list_documents",
        "title": "List documents",
        "description": "List governed documents the signed-in user is allowed to see, newest first. Never returns file contents.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum documents to return."
            },
            "classification": {
              "type": "string",
              "description": "Optional classification filter, e.g. public, internal, confidential, restricted."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_document",
        "title": "Get document metadata",
        "description": "Fetch metadata for one governed document by its content id (cid). Returns metadata only, never file contents.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "cid": {
              "type": "string",
              "minLength": 3,
              "description": "The document content id (cid)."
            }
          },
          "required": [
            "cid"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_tokens",
        "title": "List ephemeral tokens",
        "description": "List ephemeral access tokens visible to the signed-in user with their scope, permissions, expiry and revocation state. Token secrets are never returned.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum tokens to return."
            },
            "active_only": {
              "type": "boolean",
              "default": false,
              "description": "When true, exclude revoked tokens."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "List clients",
        "description": "List client records the signed-in user is assigned to or otherwise permitted to see.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "description": "Maximum clients to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_audit_events",
        "title": "List audit events",
        "description": "List recent tamper-evident audit events visible to the signed-in user, newest first. Optionally filter by action or result.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum events to return."
            },
            "action": {
              "type": "string",
              "description": "Optional action filter, e.g. ai.assist, document.download."
            },
            "result": {
              "type": "string",
              "description": "Optional result filter, e.g. ok, denied, error."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
